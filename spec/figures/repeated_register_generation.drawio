<mxfile host="app.diagrams.net" modified="2026-11-01T12:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="repeated-register-options" name="Repeated Register Options">
    <mxGraphModel dx="1320" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Repeated CSR Register Generation Options&lt;br&gt;&lt;i&gt;Tùy chọn sinh thanh ghi CSR lặp&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="720" height="55" as="geometry"/></mxCell>
        <mxCell id="workbook" value="&lt;b&gt;Workbook register template&lt;/b&gt;&lt;br&gt;Base name + base offset + fields&lt;br&gt;Repeat mode + count + offset stride&lt;br&gt;&lt;i&gt;Mẫu thanh ghi trong workbook&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="80" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="mode" value="Choose replication mode&lt;br&gt;&lt;i&gt;Chọn chế độ lặp&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="220" width="280" height="90" as="geometry"/></mxCell>

        <mxCell id="fixed_title" value="&lt;b&gt;DESIGN 1 — FIXED EXPANSION&lt;/b&gt;&lt;br&gt;&lt;i&gt;Thiết kế 1 — Mở rộng số lượng cố định&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="510" height="70" as="geometry"/></mxCell>
        <mxCell id="fixed_expand" value="Expand COUNT copies during generation&lt;br&gt;Name: &lt;code&gt;base_0 ... base_(COUNT-1)&lt;/code&gt;&lt;br&gt;Offset: &lt;code&gt;base + index × stride&lt;/code&gt;&lt;br&gt;&lt;i&gt;Generator sinh COUNT bản sao; tên và chỉ số bắt đầu từ 0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="510" height="115" as="geometry"/></mxCell>
        <mxCell id="fixed_ports" value="One scalar port set per copy&lt;br&gt;Explicit address decode and register state&lt;br&gt;&lt;i&gt;Mỗi bản sao có port đơn và trạng thái riêng&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="510" height="95" as="geometry"/></mxCell>

        <mxCell id="param_title" value="&lt;b&gt;DESIGN 2 — PARAMETERIZED BANK&lt;/b&gt;&lt;br&gt;&lt;i&gt;Thiết kế 2 — Bank theo parameter&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="770" y="360" width="510" height="70" as="geometry"/></mxCell>
        <mxCell id="param_count" value="Emit &lt;code&gt;PARA_&amp;lt;GROUP&amp;gt;_COUNT&lt;/code&gt;&lt;br&gt;Workbook count is the default; instance may override it&lt;br&gt;Legal range: 1 through MAX COUNT&lt;br&gt;&lt;i&gt;Workbook đặt mặc định; module cha có thể override&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="770" y="470" width="510" height="115" as="geometry"/></mxCell>
        <mxCell id="param_rtl" value="Packed array ports: &lt;code&gt;[COUNT-1:0][FIELD_WIDTH-1:0]&lt;/code&gt;&lt;br&gt;Generate-for state and decode for each index&lt;br&gt;Address: &lt;code&gt;base + index × stride&lt;/code&gt;&lt;br&gt;&lt;i&gt;Port mảng packed, trạng thái và decode theo chỉ số&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="770" y="625" width="510" height="95" as="geometry"/></mxCell>

        <mxCell id="csr" value="&lt;b&gt;Generated APB CSR RTL module&lt;/b&gt;&lt;br&gt;Register read/write behavior is shared by both modes&lt;br&gt;&lt;i&gt;Module RTL APB CSR được sinh — logic truy cập dùng chung&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="790" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Common rules / Quy tắc chung&lt;/b&gt;&lt;br&gt;Index starts at 0; count ≥ 1; aligned offsets; no address overlap&lt;br&gt;Parameterized count is elaboration-time, not software runtime control&lt;br&gt;&lt;i&gt;Chỉ số từ 0; count ≥ 1; offset căn chỉnh; không chồng lấp&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="900" width="720" height="70" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="workbook" target="mode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="FIXED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="mode" target="fixed_title"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="PARAMETERIZED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="mode" target="param_title"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="fixed_title" target="fixed_expand"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="fixed_expand" target="fixed_ports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="param_title" target="param_count"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="param_count" target="param_rtl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="fixed_ports" target="csr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="755"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="param_rtl" target="csr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="755"/></Array></mxGeometry></mxCell>
      </root>
